# Account-specific settings. Copy to pipeline/aws.env (gitignored) and fill in.
#
# Nothing here is a credential - the AWS CLI profile still does the authenticating - but
# account ids, role ARNs, bucket names and LAN addresses identify an environment, and this
# repository is public. Keeping them in one untracked file means the scripts stay runnable
# without publishing where they ran.
#
# Both the Python entry points (through common.load_env) and the shell scripts read this file.

# Default region. Most training actually ran in us-east-2, because us-west-2 kept running
# out of capacity for the large GPU instance types.
AWS_REGION=us-west-2

# The SageMaker execution role the training jobs assume. Needs S3 access to the buckets below
# and, for the pipeline definition, Bedrock access.
SAGEMAKER_ROLE=arn:aws:iam::123456789012:role/service-role/AmazonSageMaker-ExecutionRole-EXAMPLE

# Where datasets and model artifacts go, per region. The us-west-2 default bucket follows
# SageMaker's own naming; a bucket created by SageMaker Studio has a random suffix, so both
# are named explicitly here rather than derived.
SAGEMAKER_BUCKET=sagemaker-us-west-2-123456789012
SAGEMAKER_BUCKET_US_EAST_2=sagemaker-us-east-2-123456789012

# Account id, used to build the ECR image URI for the verifier container.
AWS_ACCOUNT=123456789012

# The shared vLLM server used for local generation (brief_gen.py, teacher.py --backend local:).
VLLM_HOST=http://127.0.0.1:8001/v1
