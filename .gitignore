# Godot import cache
boulder/.godot/
# local screenshot harness output
shots/*.png
shots/.profile/
# reference footage, not redistributed
examples/
# raw asset downloads (large zips); project copies live in game/segments/characters/assets
/assets/
**/.godot/
# pipeline virtualenv and run outputs
pipeline/.venv/
pipeline/runs/
# verifier candidates (generated, never committed): ~3,600 scripts the verifier wrote and threw away
game/segments/*/candidates/
# Layers the director loop accepted ARE committed (2026-09-16): the published game and its
# right-click menu are made of them, so a fresh clone that cannot see them exports a different
# game from the one on the site. Rejected attempts stay out.
game/segments/*/generated/*-rejected.gd
game/segments/*/generated/*-rejected.gd.uid
__pycache__/
pipeline/.venv-train/
