// Specialist pipeline: stages and milestones. Render with
//   dot -Tpng design/pipeline.dot -o design/pipeline.png
digraph pipeline {
  rankdir=TB;
  fontname="Helvetica";
  fontsize=12;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.18,0.08", color="#444444"];
  edge [color="#555555", arrowsize=0.8, fontname="Helvetica", fontsize=9];
  compound=true;
  nodesep=0.35;
  ranksep=0.7;

  // status palette
  // done = green, running = amber, next = blue, later = grey

  subgraph cluster_m0 {
    label="M0  Gold scenes  (done)"; style="rounded,filled"; fillcolor="#eef7ee"; color="#7bb07b";
    m0a [label="Beach Walk + Street Drive\nsegment-first layers, worlds, briefs", fillcolor="#cfe9cf"];
    m0b [label="Reference clips\nexamples/ study sheets", fillcolor="#cfe9cf"];
    m0c [label="World contract\nSceneLayer, WorldContext, swap hook", fillcolor="#cfe9cf"];
    m0b -> m0a -> m0c [style=invis];
    {rank=same; m0b; m0a; m0c;}
  }

  subgraph cluster_m1 {
    label="M1  Verifier  (done for sky, vegetation, props, ground, water)"; style="rounded,filled"; fillcolor="#eef7ee"; color="#7bb07b";
    v1 [label="Static gate\nextends SceneLayer, no forbidden APIs", fillcolor="#cfe9cf"];
    v2 [label="Runtime gate\nheadless boot, no script errors", fillcolor="#cfe9cf"];
    v3 [label="Native capture\nGPU, 3 views, stats.json", fillcolor="#cfe9cf"];
    v4 [label="Checks\nsun angles, palette, budget, brightness", fillcolor="#cfe9cf"];
    v5 [label="Judge\nClaude Sonnet 5 + rubric -> scores, evidence\n(ground / water / street props: vs shipped reference frames)", fillcolor="#cfe9cf"];
    v6 [label="Aggregate\nscore, pass, revision brief", fillcolor="#cfe9cf"];
    v1 -> v2 -> v3 -> v4 -> v5 -> v6;
    {rank=same; v1; v2; v3; v4; v5; v6;}
  }

  subgraph cluster_m2 {
    label="M2  Data generation  (sky done: 293 examples; scale-up runs in progress for ground, water, vegetation, props: target 100+ each)"; style="rounded,filled"; fillcolor="#fff6e5"; color="#d9a441";
    d1 [label="Brief sampler\ntime of day x weather x palette", fillcolor="#ffe3b0"];
    d2 [label="Teacher\nClaude Sonnet 5 writes 2 candidates / brief", fillcolor="#ffe3b0"];
    d3 [label="Verify\npass -> example, fail -> evidence", fillcolor="#ffe3b0"];
    d4 [label="Revise\nteacher fixes fails from evidence", fillcolor="#ffe3b0"];
    d5 [label="SFT dataset\ntrain / val / preferences / held-out briefs", fillcolor="#ffe3b0"];
    d1 -> d2 -> d3 -> d4 -> d5;
    d4 -> d3 [constraint=false, label="re-verify", style=dashed];
    {rank=same; d1; d2; d3; d4; d5;}
  }

  subgraph cluster_m3 {
    label="M3  Fine-tune specialists  (sky done; one size chosen: Qwen2.5-Coder-3B for every segment; min 100 examples)"; style="rounded,filled"; fillcolor="#eef7ee"; color="#7bb07b";
    t1 [label="SFT training job\nQwen2.5-Coder + LoRA per segment (SageMaker, us-east-2)", fillcolor="#cfe9cf"];
    t2 [label="Bake-off\nsky: 1.5B and 3B 77% one-shot, 7B 60%, teacher 60%", fillcolor="#cfe9cf"];
    t3 [label="Evaluate\nsame verifier, one self-revision round", fillcolor="#cfe9cf"];
    t4 [label="Model Registry\napproval gated on pass rate (not yet run)", fillcolor="#cfdcf5"];
    t1 -> t2 -> t3 -> t4;
    {rank=same; t1; t2; t3; t4;}
  }

  subgraph cluster_m4 {
    label="M4  Agentic loop  (whole scenes from sky, ground and vegetation 3B specialists; composite verifier built)"; style="rounded,filled"; fillcolor="#e9f0fb"; color="#5b8dd6";
    l1 [label="Director\nClaude Fable 5.1: scene brief -> segment briefs\n(palette, scale, style shared)", fillcolor="#cfe9cf"];
    l2 [label="Specialists\nsky, ground, vegetation: local 3B adapters\nprops, water: shipped layers until trained", fillcolor="#cfe9cf"];
    l3 [label="Per-layer verifier\neach layer alone, rendered in the scene", fillcolor="#cfe9cf"];
    l3b [label="Composite verifier\nassembled scene, whole-scene rubric (Opus),\nblame routed back to specialists\n3 demo scenes: 2 pass; overcast street fails on its sky", fillcolor="#cfe9cf"];
    l4 [label="Revise\nup to 3 rounds from evidence", fillcolor="#cfe9cf"];
    l5 [label="Publish\ninstall layers: automated (director)\nweb export + GitHub Pages: by hand", fillcolor="#ffe3b0"];
    l1 -> l2 -> l3 -> l3b -> l4 -> l5;
    l4 -> l2 [constraint=false, label="revision briefs", style=dashed];
    {rank=same; l1; l2; l3; l3b; l4; l5;}
  }

  subgraph cluster_m5 {
    label="M5  Segments through M1-M4   (each needs: contract, rubric, brief sampler, checks, capture recipe)   <- current milestone"; style="rounded,filled"; fillcolor="#fff6e5"; color="#d9a441";
    g0 [label="sky\nspecialist trained + evaluated\n(1.5B / 3B beat the teacher one-shot)", fillcolor="#cfe9cf"];
    g1 [label="ground / water\nground: 3B on 194 examples + repairs, 25 held out:\n24% one-shot, 44% after one self-revision (teacher 34%)\nwater: 85 examples, paused below 100 (judge question)", fillcolor="#ffe3b0"];
    g2 [label="camera\nframing box, stabilisation", fillcolor="#e0e0e0"];
    g3 [label="fauna\nflock motion, flush behaviour", fillcolor="#e0e0e0"];
    g4 [label="props\n3B on 219 examples + repairs (Opus judge), 21 held out:\n9.5% one-shot and after revision (teacher 52%)\nbeach: extra closing braces; street: undeclared names, invented methods", fillcolor="#ffe3b0"];
    g5 [label="vegetation\n3B on 289 examples + repairs (Opus judge), 18 held out:\n72% one-shot, 83% after one self-revision (teacher 57%)\nonly 3 of the 18 held-out briefs are beach", fillcolor="#cfe9cf"];
    g6 [label="architecture\nlots, facades, skyline", fillcolor="#e0e0e0"];
    g7 [label="crowd\ncontact validator, gaits", fillcolor="#e0e0e0"];
    g8 [label="characters: body + motion\nSFT only, cached assets", fillcolor="#e0e0e0"];
    g9 [label="vehicles + player modes\nfollowing, entry / exit", fillcolor="#e0e0e0"];
    g0 -> g1 -> g2 -> g3 -> g4 [color="#999999"];
    g4 -> g5 -> g6 -> g7 [color="#999999"];
    g7 -> g8 -> g9 [color="#999999"];
    {rank=same; g0; g1; g2; g3; g4;}
    {rank=same; g5; g6; g7; g8; g9;}
  }

  subgraph cluster_m6 {
    label="M6  RL with verifiable rewards  (where SFT plateaus)"; style="rounded,filled"; fillcolor="#f3f3f3"; color="#999999";
    r1 [label="GRPO episodes\nverifier as the environment, reward = checks + judge win rate", fillcolor="#e0e0e0"];
    r2 [label="Anchor set + human review\nguard against reward hacking", fillcolor="#e0e0e0"];
    r1 -> r2;
    {rank=same; r1; r2;}
  }

  subgraph cluster_m7 {
    label="M7  Holistic scene generation  (one brief in, a playable scene out)"; style="rounded,filled"; fillcolor="#f3f3f3"; color="#999999";
    h1 [label="Second world under the contract\n(a new biome proves the contract generalises)", fillcolor="#e0e0e0"];
    h2 [label="Director writes the world assembly\ncontext (terrain, constants) + layer order + brief", fillcolor="#e0e0e0"];
    h3 [label="All specialists + composite verifier\nevery layer from a small model, accepted by one verifier", fillcolor="#e0e0e0"];
    h1 -> h2 -> h3;
    {rank=same; h1; h2; h3;}
  }

  // milestone flow (top to bottom, one row per milestone)
  m0c -> v1 [ltail=cluster_m0, lhead=cluster_m1, label="  contract + capture recipe"];
  v1 -> d1 [ltail=cluster_m1, lhead=cluster_m2, label="  the same verifier filters the data"];
  d1 -> t1 [ltail=cluster_m2, lhead=cluster_m3, label="  dataset to S3"];
  t1 -> l1 [ltail=cluster_m3, lhead=cluster_m4, label="  deploy the adapter"];
  l1 -> g0 [ltail=cluster_m4, lhead=cluster_m5, label="  repeat M1 to M4 per segment, in this order"];
  g5 -> r1 [ltail=cluster_m5, lhead=cluster_m6, label="  cheap, honest rewards first: sky, ground, camera", style=dashed];
  g8 -> h1 [ltail=cluster_m5, lhead=cluster_m7, label="  all segments have specialists"];
  v6 -> l3 [style=dashed, color="#7bb07b", label="  the same verifier accepts in the loop", constraint=false];
  l3b -> h3 [style=dashed, color="#5b8dd6", label="  composite verifier is what makes M7 possible", constraint=false];
}
